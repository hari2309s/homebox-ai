{
  "name": "homebox-ai",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @homebox-ai/db generate",
    "db:migrate": "pnpm --filter @homebox-ai/db migrate",
    "test": "vitest run --exclude 'apps/web/e2e/**'",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": ">=4.3.2",
      "brace-expansion@^1": "^1.1.20",
      "brace-expansion@>4": ">=5.0.11",
      "minimatch@>=9": ">=11.0.1",
      "sharp": ">=0.35.5",
      "postcss": ">=8.5.26",
      "browserslist": ">=4.28.7",
      "@grpc/grpc-js": ">=1.14.5",
      "source-map-js": ">=1.2.2",
      "zod": ">=4.6.6",
      "glob@>=9": ">=14.0.2",
      "vite": ">=8.2.4",
      "esbuild": ">=0.25.0"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "@langfuse/client": "^5.10.1",
    "tsx": "^4.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  }
}
