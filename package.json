{
  "name": "homebox-ai",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @homebox-ai/db generate",
    "db:migrate": "pnpm --filter @homebox-ai/db migrate",
    "test": "vitest run --exclude 'apps/web/e2e/**'",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
