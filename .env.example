# Supabase (from your project's Settings > API, or `supabase status` for local dev)
# Publishable/secret are Supabase's current key names (sb_publishable_.../sb_secret_...),
# replacing the older anon/service_role JWT keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Direct Postgres connection, used by Drizzle Kit for migrations and by
# packages/db's runtime queries (see packages/db/src/rls.ts for why RLS is
# enforced manually there instead of relying on PostgREST).
DATABASE_URL=

# AI providers (all free-tier) — packages/ai/src/router.ts routes tasks
# across these with fallback; only providers with a key set will work.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
GROQ_API_KEY=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
# Fallback for OpenRouter on text-only tasks (chat tool-calling, reasoning) —
# kept separate from OPENROUTER_VISION_MODEL since a vision-tuned free model
# isn't necessarily good at (or compatible with) tool-calling. Falls back to
# OPENROUTER_VISION_MODEL if unset.
OPENROUTER_MODEL=
CRON_SECRET=

# Langfuse (LLM observability/tracing) — get keys from cloud.langfuse.com > Project Settings > API Keys
# Both public and secret keys must be set; if either is missing, all AI tracing is silently disabled.
# Add these to Vercel environment variables (Production + Preview) to see traces in production.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Playwright e2e — a dedicated persistent Supabase Auth user (not a real
# person's account), logged in once by apps/web/e2e/global-setup.ts and
# reused across authenticated specs. See apps/web/e2e/README.md to create one.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
